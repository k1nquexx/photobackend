# ==============================================================================
# ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ ДЛЯ РАЗВЕРТЫВАНИЯ СЕРВИСА (ФОТОПОРТФОЛИО)
# Скопируйте этот файл в .env и заполните реальными секретами.
# ВНИМАНИЕ: Файл .env должен быть добавлен в .gitignore и не попадать в репозиторий!
# ==============================================================================

# 1. Безопасность администратора
# Постоянный SHA-256 хэш пароля администратора (рекомендуется для продакшна):
ADMIN_PASSWORD_HASH=a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3

# Либо открытый пароль при первоначальном запуске (хэшируется приложением):
# ADMIN_PASSWORD=StrongAdminSecretPassword2026!

# 2. Подключение к реляционной СУБД (PostgreSQL / MySQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/photodb
SPRING_DATASOURCE_USERNAME=photo_user
SPRING_DATASOURCE_PASSWORD=strong_database_password_here
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# 3. Политика CORS (разрешенные домены сайта без пробелов и слешей на конце)
CORS_ALLOWED_ORIGINS=https://myphotosite.ru,https://www.myphotosite.ru

# 4. Профиль Spring (по умолчанию dev, для продакшна prod)
# SPRING_PROFILES_ACTIVE=prod
